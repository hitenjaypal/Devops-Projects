# Terraform state files — NEVER commit these (contain resource IDs, IPs, secrets)
*.tfstate
*.tfstate.backup

# Terraform working directory
.terraform/
.terraform.lock.hcl

# Variable files that may contain sensitive values (IPs, key names)
terraform.tfvars
*.auto.tfvars

# Crash logs
crash.log
crash.*.log

# Override files (used locally, not meant for team sharing)
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# SSH keys — absolutely never commit
*.pem
*.ppk
